NODE_ENV=development
PORT=5000
DATABASE_URL=mysql://root:password@localhost:3306/f1_fashion_store
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_PREFIX=/api/v1
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
TRUST_PROXY=false
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters-for-access-token-1234567890
JWT_REFRESH_SECRET=replace-with-at-least-64-different-random-characters-for-refresh-token
JWT_ISSUER=f1-fashion-store-api
JWT_AUDIENCE=f1-fashion-store-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=f1_refresh
BCRYPT_ROUNDS=12
