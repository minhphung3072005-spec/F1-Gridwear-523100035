generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum InventoryTransactionType {
  IMPORT
  SALE
  CANCEL_RETURN
  MANUAL_ADJUSTMENT
  RETURN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  COD
  VNPAY
  MOMO
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponRedemptionStatus {
  APPLIED
  RELEASED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum UploadProviderType {
  LOCAL
  CLOUDINARY
}

model User {
  id           String    @id @default(cuid()) @db.VarChar(32)
  email        String    @unique(map: "uq_users_email") @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(2048)
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true) @map("is_active")
  tokenVersion Int       @default(0) @map("token_version")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(3)

  refreshSessions      RefreshSession[]
  passwordResetTokens  PasswordResetToken[]
  addresses            Address[]
  cart                 Cart?
  favorites            Favorite[]
  orders               Order[]
  reviews              Review[]
  couponRedemptions    CouponRedemption[]
  checkoutRequests     CheckoutIdempotency[]
  uploadedAssets       UploadAsset[]          @relation("UploadedAssets")
  inventoryAdjustments InventoryTransaction[] @relation("InventoryActor")
  orderStatusChanges   OrderStatusHistory[]   @relation("OrderStatusActor")

  @@index([phone], map: "idx_users_phone")
  @@index([role, isActive], map: "idx_users_role_active")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model RefreshSession {
  id           String    @id @default(cuid()) @db.VarChar(32)
  userId       String    @map("user_id") @db.VarChar(32)
  familyId     String    @map("family_id") @db.VarChar(32)
  tokenHash    String    @unique(map: "uq_refresh_sessions_token_hash") @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById String?   @unique(map: "uq_refresh_sessions_replaced_by") @map("replaced_by_id") @db.VarChar(32)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshSession? @relation("RefreshRotation")

  @@index([userId, revokedAt], map: "idx_refresh_sessions_user_revoked")
  @@index([familyId, revokedAt], map: "idx_refresh_sessions_family_revoked")
  @@index([expiresAt], map: "idx_refresh_sessions_expires_at")
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @db.VarChar(32)
  userId    String    @map("user_id") @db.VarChar(32)
  tokenHash String    @unique(map: "uq_password_reset_tokens_hash") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_password_reset_tokens_expires_at")
  @@index([userId, usedAt], map: "idx_password_reset_tokens_user_used")
  @@map("password_reset_tokens")
}

model Address {
  id            String   @id @default(cuid()) @db.VarChar(32)
  userId        String   @map("user_id") @db.VarChar(32)
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone         String   @db.VarChar(20)
  line1         String   @db.VarChar(255)
  line2         String?  @db.VarChar(255)
  ward          String   @db.VarChar(100)
  district      String   @db.VarChar(100)
  province      String   @db.VarChar(100)
  postalCode    String?  @map("postal_code") @db.VarChar(20)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault], map: "idx_addresses_user_default")
  @@map("addresses")
}

model Category {
  id          String    @id @default(cuid()) @db.VarChar(32)
  name        String    @db.VarChar(100)
  slug        String    @unique(map: "uq_categories_slug") @db.VarChar(120)
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.VarChar(2048)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)

  products Product[]

  @@index([isActive, sortOrder], map: "idx_categories_active_sort")
  @@index([name], map: "idx_categories_name")
  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid()) @db.VarChar(32)
  name        String    @db.VarChar(100)
  slug        String    @unique(map: "uq_brands_slug") @db.VarChar(120)
  logoUrl     String?   @map("logo_url") @db.VarChar(2048)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)

  products Product[]

  @@index([isActive, sortOrder], map: "idx_brands_active_sort")
  @@index([name], map: "idx_brands_name")
  @@map("brands")
}

model Product {
  id               String        @id @default(cuid()) @db.VarChar(32)
  categoryId       String        @map("category_id") @db.VarChar(32)
  brandId          String        @map("brand_id") @db.VarChar(32)
  name             String        @db.VarChar(200)
  slug             String        @unique(map: "uq_products_slug") @db.VarChar(220)
  shortDescription String?       @map("short_description") @db.VarChar(500)
  description      String?       @db.Text
  basePrice        Decimal       @map("base_price") @db.Decimal(12, 2)
  salePrice        Decimal?      @map("sale_price") @db.Decimal(12, 2)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  publishedAt      DateTime?     @map("published_at") @db.DateTime(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime?     @map("deleted_at") @db.DateTime(3)

  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand      Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  variants   ProductVariant[]
  favorites  Favorite[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([name], map: "idx_products_name")
  @@index([status, createdAt], map: "idx_products_status_created")
  @@index([categoryId, status], map: "idx_products_category_status")
  @@index([brandId, status], map: "idx_products_brand_status")
  @@index([isFeatured, status], map: "idx_products_featured_status")
  @@map("products")
}

model UploadAsset {
  id              String             @id @default(cuid()) @db.VarChar(32)
  provider        UploadProviderType
  providerAssetId String             @map("provider_asset_id") @db.VarChar(255)
  url             String             @db.VarChar(2048)
  width           Int?
  height          Int?
  format          String             @db.VarChar(20)
  bytes           Int
  uploadedById    String?            @map("uploaded_by_id") @db.VarChar(32)
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt       DateTime?          @map("deleted_at") @db.DateTime(3)

  uploadedBy    User?          @relation("UploadedAssets", fields: [uploadedById], references: [id], onDelete: SetNull)
  productImages ProductImage[]

  @@unique([provider, providerAssetId], map: "uq_upload_assets_provider_asset")
  @@index([deletedAt], map: "idx_upload_assets_deleted_at")
  @@map("upload_assets")
}

model ProductImage {
  id          String   @id @default(cuid()) @db.VarChar(32)
  productId   String   @map("product_id") @db.VarChar(32)
  assetId     String?  @map("asset_id") @db.VarChar(32)
  urlSnapshot String   @map("url_snapshot") @db.VarChar(2048)
  altText     String?  @map("alt_text") @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   UploadAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([productId, sortOrder], map: "uq_product_images_product_sort")
  @@index([productId, isPrimary], map: "idx_product_images_product_primary")
  @@index([assetId], map: "idx_product_images_asset")
  @@map("product_images")
}

model Size {
  id        String  @id @default(cuid()) @db.VarChar(32)
  name      String  @unique(map: "uq_sizes_name") @db.VarChar(50)
  slug      String  @unique(map: "uq_sizes_slug") @db.VarChar(60)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  variants ProductVariant[]

  @@index([isActive, sortOrder], map: "idx_sizes_active_sort")
  @@map("sizes")
}

model Color {
  id        String  @id @default(cuid()) @db.VarChar(32)
  name      String  @unique(map: "uq_colors_name") @db.VarChar(100)
  slug      String  @unique(map: "uq_colors_slug") @db.VarChar(120)
  hexCode   String? @map("hex_code") @db.Char(7)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  variants ProductVariant[]

  @@index([isActive, sortOrder], map: "idx_colors_active_sort")
  @@map("colors")
}

model ProductVariant {
  id        String    @id @default(cuid()) @db.VarChar(32)
  productId String    @map("product_id") @db.VarChar(32)
  sizeId    String    @map("size_id") @db.VarChar(32)
  colorId   String    @map("color_id") @db.VarChar(32)
  sku       String    @unique(map: "uq_product_variants_sku") @db.VarChar(64)
  price     Decimal?  @db.Decimal(12, 2)
  salePrice Decimal?  @map("sale_price") @db.Decimal(12, 2)
  stock     Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  size                  Size                   @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color                 Color                  @relation(fields: [colorId], references: [id], onDelete: Restrict)
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([productId, sizeId, colorId], map: "uq_product_variants_combination")
  @@index([productId, isActive], map: "idx_product_variants_product_active")
  @@index([stock, isActive], map: "idx_product_variants_stock_active")
  @@index([sizeId, stock], map: "idx_product_variants_size_stock")
  @@index([colorId, stock], map: "idx_product_variants_color_stock")
  @@map("product_variants")
}

model Cart {
  id        String   @id @default(cuid()) @db.VarChar(32)
  userId    String   @unique(map: "uq_carts_user") @map("user_id") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid()) @db.VarChar(32)
  cartId    String   @map("cart_id") @db.VarChar(32)
  variantId String   @map("variant_id") @db.VarChar(32)
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId], map: "uq_cart_items_cart_variant")
  @@index([variantId], map: "idx_cart_items_variant")
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(cuid()) @db.VarChar(32)
  userId    String   @map("user_id") @db.VarChar(32)
  productId String   @map("product_id") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], map: "uq_favorites_user_product")
  @@index([productId], map: "idx_favorites_product")
  @@map("favorites")
}

model Coupon {
  id            String     @id @default(cuid()) @db.VarChar(32)
  code          String     @unique(map: "uq_coupons_code") @db.VarChar(50)
  type          CouponType
  value         Decimal    @db.Decimal(12, 2)
  minOrderValue Decimal    @default(0) @map("min_order_value") @db.Decimal(12, 2)
  maxDiscount   Decimal?   @map("max_discount") @db.Decimal(12, 2)
  startAt       DateTime   @map("start_at") @db.DateTime(3)
  endAt         DateTime   @map("end_at") @db.DateTime(3)
  usageLimit    Int?       @map("usage_limit")
  perUserLimit  Int?       @map("per_user_limit")
  usedCount     Int        @default(0) @map("used_count")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime?  @map("deleted_at") @db.DateTime(3)

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([code, isActive], map: "idx_coupons_code_active")
  @@index([isActive, startAt, endAt], map: "idx_coupons_active_window")
  @@map("coupons")
}

model Order {
  id            String        @id @default(cuid()) @db.VarChar(32)
  userId        String        @map("user_id") @db.VarChar(32)
  couponId      String?       @map("coupon_id") @db.VarChar(32)
  orderCode     String        @unique(map: "uq_orders_order_code") @map("order_code") @db.VarChar(40)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  receiverName  String        @map("receiver_name") @db.VarChar(100)
  receiverPhone String        @map("receiver_phone") @db.VarChar(20)
  receiverEmail String?       @map("receiver_email") @db.VarChar(254)
  addressLine1  String        @map("address_line_1") @db.VarChar(255)
  addressLine2  String?       @map("address_line_2") @db.VarChar(255)
  ward          String        @db.VarChar(100)
  district      String        @db.VarChar(100)
  province      String        @db.VarChar(100)
  postalCode    String?       @map("postal_code") @db.VarChar(20)
  couponCode    String?       @map("coupon_code") @db.VarChar(50)
  note          String?       @db.VarChar(500)
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  shippingFee   Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAt        DateTime?     @map("paid_at") @db.DateTime(3)
  deliveredAt   DateTime?     @map("delivered_at") @db.DateTime(3)
  cancelledAt   DateTime?     @map("cancelled_at") @db.DateTime(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon                Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  inventoryTransactions InventoryTransaction[]
  couponRedemption      CouponRedemption?
  checkoutRequest       CheckoutIdempotency?
  payments              Payment[]

  @@index([userId, createdAt], map: "idx_orders_user_created")
  @@index([status, createdAt], map: "idx_orders_status_created")
  @@index([paymentStatus, createdAt], map: "idx_orders_payment_status_created")
  @@index([createdAt], map: "idx_orders_created_at")
  @@index([deliveredAt], map: "idx_orders_delivered_at")
  @@index([receiverPhone], map: "idx_orders_receiver_phone")
  @@index([couponId], map: "idx_orders_coupon")
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid()) @db.VarChar(32)
  orderId     String   @map("order_id") @db.VarChar(32)
  productId   String?  @map("product_id") @db.VarChar(32)
  variantId   String?  @map("variant_id") @db.VarChar(32)
  productName String   @map("product_name") @db.VarChar(200)
  sku         String   @db.VarChar(64)
  size        String   @db.VarChar(50)
  color       String   @db.VarChar(100)
  imageUrl    String?  @map("image_url") @db.VarChar(2048)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product               Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant               ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)
  inventoryTransactions InventoryTransaction[]
  review                Review?

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@index([variantId], map: "idx_order_items_variant")
  @@index([sku], map: "idx_order_items_sku")
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid()) @db.VarChar(32)
  orderId    String       @map("order_id") @db.VarChar(32)
  actorId    String?      @map("actor_id") @db.VarChar(32)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User? @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt], map: "idx_order_status_history_order_created")
  @@index([actorId], map: "idx_order_status_history_actor")
  @@map("order_status_history")
}

model CouponRedemption {
  id             String                 @id @default(cuid()) @db.VarChar(32)
  couponId       String                 @map("coupon_id") @db.VarChar(32)
  userId         String                 @map("user_id") @db.VarChar(32)
  orderId        String                 @unique(map: "uq_coupon_redemptions_order") @map("order_id") @db.VarChar(32)
  status         CouponRedemptionStatus @default(APPLIED)
  discountAmount Decimal                @map("discount_amount") @db.Decimal(12, 2)
  appliedAt      DateTime               @default(now()) @map("applied_at") @db.DateTime(3)
  releasedAt     DateTime?              @map("released_at") @db.DateTime(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId], map: "uq_coupon_redemptions_coupon_order")
  @@index([couponId, status], map: "idx_coupon_redemptions_coupon_status")
  @@index([couponId, userId, status], map: "idx_coupon_redemptions_coupon_user_status")
  @@index([userId], map: "idx_coupon_redemptions_user")
  @@map("coupon_redemptions")
}

model CheckoutIdempotency {
  id             String            @id @default(cuid()) @db.VarChar(32)
  userId         String            @map("user_id") @db.VarChar(32)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(64)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  orderId        String?           @unique(map: "uq_checkout_idempotencies_order") @map("order_id") @db.VarChar(32)
  responseStatus Int?              @map("response_status") @db.SmallInt
  expiresAt      DateTime          @map("expires_at") @db.DateTime(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey], map: "uq_checkout_idempotencies_user_key")
  @@index([expiresAt], map: "idx_checkout_idempotencies_expires_at")
  @@map("checkout_idempotencies")
}

model Payment {
  id                    String          @id @default(cuid()) @db.VarChar(32)
  orderId               String          @map("order_id") @db.VarChar(32)
  provider              PaymentProvider
  providerTransactionId String?         @map("provider_transaction_id") @db.VarChar(255)
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("VND") @db.Char(3)
  status                PaymentStatus   @default(PENDING)
  metadata              Json?
  paidAt                DateTime?       @map("paid_at") @db.DateTime(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId], map: "uq_payments_provider_transaction")
  @@index([orderId, createdAt], map: "idx_payments_order_created")
  @@index([status, createdAt], map: "idx_payments_status_created")
  @@map("payments")
}

model InventoryTransaction {
  id            String                   @id @default(cuid()) @db.VarChar(32)
  variantId     String                   @map("variant_id") @db.VarChar(32)
  orderId       String?                  @map("order_id") @db.VarChar(32)
  orderItemId   String?                  @map("order_item_id") @db.VarChar(32)
  createdById   String?                  @map("created_by_id") @db.VarChar(32)
  type          InventoryTransactionType
  quantityDelta Int                      @map("quantity_delta")
  stockBefore   Int                      @map("stock_before")
  stockAfter    Int                      @map("stock_after")
  reference     String?                  @db.VarChar(100)
  reason        String?                  @db.VarChar(500)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.DateTime(3)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("InventoryActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt], map: "idx_inventory_transactions_variant_created")
  @@index([orderId], map: "idx_inventory_transactions_order")
  @@index([orderItemId], map: "idx_inventory_transactions_order_item")
  @@index([type, createdAt], map: "idx_inventory_transactions_type_created")
  @@index([reference], map: "idx_inventory_transactions_reference")
  @@index([createdById], map: "idx_inventory_transactions_actor")
  @@map("inventory_transactions")
}

model Review {
  id          String       @id @default(cuid()) @db.VarChar(32)
  userId      String       @map("user_id") @db.VarChar(32)
  productId   String       @map("product_id") @db.VarChar(32)
  orderItemId String       @unique(map: "uq_reviews_order_item") @map("order_item_id") @db.VarChar(32)
  rating      Int
  title       String?      @db.VarChar(150)
  content     String?      @db.Text
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime?    @map("deleted_at") @db.DateTime(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([userId, productId], map: "uq_reviews_user_product")
  @@index([productId, status, createdAt], map: "idx_reviews_product_status_created")
  @@index([productId, rating], map: "idx_reviews_product_rating")
  @@index([userId, createdAt], map: "idx_reviews_user_created")
  @@map("reviews")
}
